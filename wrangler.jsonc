// Configuración del Worker de Cloudflare que publica la landing.
// "name" tiene que coincidir con el nombre del Worker en el panel de Cloudflare.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-veleta-entradas",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Variables visibles (no secretas). La clave de Resend va aparte, como secreto, en el panel de Cloudflare.
  // Ojo: lo que esté aquí manda sobre lo que se escriba en el panel para estas mismas variables.
  "vars": {
    "EMAIL_TO": "veletavlc@gmail.com"
  },
  "observability": { "enabled": true }
}
